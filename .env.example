# ModernDVWA environment template.
# Copy to .env and adjust. NEVER commit your real .env.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Address the Go API listens on (inside its container use 0.0.0.0).
SERVER_ADDR=":8080"
# Host-side port published for the backend container (container always listens on 8080).
# Change if another service on your machine already uses this port.
BACKEND_HOST_PORT="8080"
FRONTEND_HOST_PORT="5173"
# Public base URL of the API, used by the frontend proxy in development.
BACKEND_URL="http://localhost:8080"

# debug | info | warn | error
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_USER="moderndvwa"
POSTGRES_PASSWORD="devpassword"        # change for any non-throwaway setup
POSTGRES_DB="moderndvwa"
# Full DSN used by the backend; keep consistent with the values above.
DATABASE_DSN="postgres://moderndvwa:devpassword@postgres:5432/moderndvwa?sslmode=disable"

# When running the backend directly on the host (docker compose up -d postgres):
# DATABASE_DSN="postgres://moderndvwa:devpassword@localhost:5432/moderndvwa?sslmode=disable"

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate a dev secret:  openssl rand -base64 48
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
# Access token lifetime, e.g. "15m", "1h".
JWT_TTL="1h"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Host-side port for the Vite dev/preview server. Change if 5173 is taken.
FRONTEND_PORT="5173"
# Where the frontend sends API requests (Vite dev server proxies this).
VITE_API_BASE_URL="/api/v1"
